using Gtk 4.0;
using Adw 1;

Adw.Dialog dialog {
  title: _("Add Repository");
  content-width: 420;

  child: Adw.ToolbarView toolbar_view {
    [top]
    Adw.HeaderBar {
      title-widget: Adw.WindowTitle {
        title: _("Add Repository");
      };
    }

    content: Gtk.Box {
      orientation: vertical;

      Adw.PreferencesPage {
        Adw.PreferencesGroup {
          Adw.EntryRow name_row {
            title: _("Name");
          }

          Adw.ComboRow backend_row {
            title: _("Repository Type");
            model: Gtk.StringList {
              strings [_("Local"), "SFTP", "S3-compatible"]
            };
          }
        }

        Adw.PreferencesGroup local_group {
          Adw.ActionRow location_row {
            title: _("Location");
            subtitle: _("No folder selected");
            activatable: true;

            [suffix]
            Gtk.Image {
              icon-name: "folder-symbolic";
            }
          }
        }

        Adw.PreferencesGroup sftp_group {
          visible: false;
          description: _("SFTP uses this machine's existing SSH key or agent — there is no password field here.");

          Adw.EntryRow host_row {
            title: _("Host");
          }

          Adw.EntryRow sftp_path_row {
            title: _("Remote Path");
          }

          Adw.EntryRow user_row {
            title: _("Username");
          }
        }

        Adw.PreferencesGroup s3_group {
          visible: false;

          Adw.EntryRow endpoint_row {
            title: _("Endpoint");
          }

          Adw.EntryRow bucket_row {
            title: _("Bucket");
          }

          Adw.EntryRow access_key_row {
            title: _("Access Key ID");
          }

          Adw.PasswordEntryRow secret_key_row {
            title: _("Secret Access Key");
          }
        }

        Adw.PreferencesGroup {
          Adw.PasswordEntryRow password_row {
            title: _("Repository Password");
          }
        }
      }

      Gtk.Label error_label {
        css-classes: ["error"];
        wrap: true;
        visible: false;
      }
    };

    [bottom]
    Gtk.Box {
      orientation: horizontal;
      spacing: 8;
      margin-top: 8;
      margin-bottom: 8;
      margin-start: 12;
      margin-end: 12;

      Gtk.Button cancel_button {
        label: _("Cancel");
      }

      Gtk.Box {
        hexpand: true;
      }

      Gtk.Button add_button {
        label: _("Add");
        styles ["suggested-action"]
        sensitive: false;
      }
    }
  };
}
